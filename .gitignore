# Secrets & credentials — never commit
# (narrow patterns — must NOT match source files like connectors/credentials.py)
.env
.env.*
*.key
*.pem
*.credentials
secrets.json
secrets.yaml
.openvitals/        # default local credential store

# Developer integration scripts — contain implementation-specific references
scripts/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Sync output / local data
*.jsonl
*.sqlite
*.db

# OS / editor
.DS_Store
.idea/
.vscode/
